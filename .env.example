# Piezas de PostgreSQL. En el host, PostGIS se publica en el puerto 5433.
# Dentro de Compose el backend usa el hostname db y el puerto interno 5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=ecologistica
DB_PASSWORD=ecologistica
DB_NAME=ecologistica

# Conexión async del proceso que corre en el host (pytest, uvicorn local).
DATABASE_URL=postgresql+asyncpg://ecologistica:ecologistica@localhost:5433/ecologistica

# Clave de la aplicación. Cámbiala fuera de este equipo.
SECRET_KEY=cambia-esta-clave-en-produccion-local

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

APP_DEBUG=false

# demo | staging | production — en producción exige SECRET_KEY fuerte y sin cuentas demo.
APP_ENVIRONMENT=demo
ALLOW_DEMO_ACCOUNTS=true

# Redirección HTTP→HTTPS detrás del proxy (activar en staging/producción).
FORCE_HTTPS=false

# Duración del JWT: usa AUTH_TOKEN_MINUTES (opcional) o AUTH_TOKEN_HOURS (predeterminado 12).
# AUTH_TOKEN_MINUTES=15
AUTH_TOKEN_HOURS=12

# Jornada operativa del conductor (RN-003 configurable; validación normativa pendiente).
# MAX_SHIFT_MINUTES=480
# ENFORCE_SHIFT_LIMIT=true
# SHIFT_LIMIT_NORMATIVE_VALIDATED=false

# Semilla del algoritmo genético de rutas (reproducibilidad).
# OPTIMIZER_SEED=42

# OSRM local (opcional). Vacío = distancias geodésicas Haversine para el GA y ETAs.
# OSRM_BASE_URL=http://localhost:5000

# EN-001 / RNF-001 — presupuesto del solver (segundos).
# OPTIMIZER_TIME_BUDGET_SECONDS=45
# OPTIMIZER_MAX_GENERATIONS=100
# OPTIMIZER_MAX_POPULATION=50
