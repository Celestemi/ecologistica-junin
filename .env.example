# Piezas de PostgreSQL. En el host, PostGIS se publica en el puerto 5433.
# Dentro de Compose el backend usa el hostname db y el puerto interno 5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=ecologistica
DB_PASSWORD=ecologistica
DB_NAME=ecologistica

# Conexión async del proceso que corre en el host (pytest, uvicorn local).
DATABASE_URL=postgresql+asyncpg://ecologistica:ecologistica@localhost:5433/ecologistica

# Clave de la aplicación. Cámbiala fuera de este equipo.
SECRET_KEY=cambia-esta-clave-en-produccion-local

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

APP_DEBUG=false
