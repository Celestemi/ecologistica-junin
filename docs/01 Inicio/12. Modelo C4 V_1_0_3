    Rel(spa_pwa, auth_comp, "Autentica peticiones JWT")
    Rel(auth_comp, fleet_comp, "Autoriza acceso")
    Rel(auth_comp, order_comp, "Autoriza acceso")
    Rel(auth_comp, route_comp, "Autoriza acceso")
    Rel(auth_comp, kpi_comp, "Autoriza acceso")

    Rel(order_comp, db, "Lectura / Escritura de Pedidos")
