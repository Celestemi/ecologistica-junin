    Rel(api, db, "Consultas SQL / PostGIS")
    Rel(engine, db, "Persiste rutas generadas")

    Rel(spa, maps_api, "Carga tiles de mapa")
    Rel(api, maps_api, "Consulta matrices de distancia de Huancayo")
